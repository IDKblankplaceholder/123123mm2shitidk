-- 4. TARGET SPIN-FLING LOGIC (SMOOTH RECOVERY & NO FLOATING)
--------------------------------------------------------------------
local flinging = false
local flingDied = nil

local function getPlayerByMatch(nameQuery)
    if not nameQuery or nameQuery == "" then return nil end
    nameQuery = nameQuery:lower()
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local username = player.Name:lower()
            local displayName = player.DisplayName:lower()
            
            if username:find(nameQuery, 1, true) or displayName:find(nameQuery, 1, true) then
                return player
            end
        end
    end
    return nil
end

local function Unfling()
    ToggleNoclip(false)
    if flingDied then 
        flingDied:Disconnect() 
        flingDied = nil
    end
    flinging = false
    
    local myChar = LocalPlayer.Character
    local myHumanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

    if myChar then
        -- Restore default collisions and physics properties
        for _, v in ipairs(myChar:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.3, 0.5)
                v.Massless = false
                v.AssemblyLinearVelocity = Vector3.zero
                v.AssemblyAngularVelocity = Vector3.zero
                v.CanCollide = true
            end
        end
    end

    -- FORCE HUMANOID RECOVERY (Fixes floating animation lock)
    if myHumanoid and myRoot then
        myHumanoid.PlatformStand = false
        myHumanoid.Sit = false
        
        -- Cycle state machine to force ground landing
        myHumanoid:ChangeState(Enum.HumanoidStateType.Freefall)
        RunService.RenderStepped:Wait()
        myHumanoid:ChangeState(Enum.HumanoidStateType.Landed)
        myHumanoid:ChangeState(Enum.HumanoidStateType.Running)

        -- Micro-teleport down slightly to trigger immediate floor collision
        myRoot.CFrame = myRoot.CFrame * CFrame.new(0, -0.1, 0)
        -- Instantly kills all active forces on the HRP
        myRoot.Anchored = true
        RunService.Stepped:Wait()
        myRoot.Anchored = false
    end

    FlingActionBtn.Text = "FLING"
end

local function FlingTarget(targetQuery)
    if flinging then 
        Unfling()
        return 
    end
    
    local Target = getPlayerByMatch(targetQuery)
    if not Target or not Target.Character then 
        FlingActionBtn.Text = "NOT FOUND"
        task.wait(1.2)
        FlingActionBtn.Text = "FLING"
        return 
    end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local targetRoot = Target.Character:FindFirstChild("HumanoidRootPart") or Target.Character:FindFirstChild("Torso")
    local myHumanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")

    if not myChar or not myRoot or not targetRoot or not myHumanoid then return end

    local originalCFrame = myRoot.CFrame
    flinging = true
    FlingActionBtn.Text = "STOP"

    -- 1. Setup physics properties & disable part collisions
    for _, child in ipairs(myChar:GetDescendants()) do
        if child:IsA("BasePart") then
            child.CustomPhysicalProperties = PhysicalProperties.new(100, 0.3, 0.5, 1, 1)
            child.CanCollide = false
        end
    end

    ToggleNoclip(true)

    flingDied = myHumanoid.Died:Connect(function()
        Unfling()
    end)

    -- 2. Spin-Fling Loop with Velocity Purge
    task.spawn(function()
        local startTime = tick()
        local rotAngle = 0

        while flinging and (tick() - startTime < 3.5) do
            RunService.RenderStepped:Wait()

            if Target.Character and Target.Character:FindFirstChild("HumanoidRootPart") and myChar and myChar:FindFirstChild("HumanoidRootPart") then
                local tRoot = Target.Character.HumanoidRootPart
                
                rotAngle = (rotAngle + 100) % 360
                
                myRoot.CFrame = tRoot.CFrame * CFrame.Angles(0, math.rad(rotAngle), math.rad(rotAngle))
                myRoot.AssemblyAngularVelocity = Vector3.new(0, 999999, 999999)
                myRoot.AssemblyLinearVelocity = Vector3.new(0, 50, 0)
            else
                break
            end
        end

        -- Kill residual physics momentum over 3 frames before resetting CFrame
        if myRoot then
            for _ = 1, 3 do
                myRoot.AssemblyLinearVelocity = Vector3.zero
                myRoot.AssemblyAngularVelocity = Vector3.zero
                RunService.RenderStepped:Wait()
            end

            if originalCFrame then
                myRoot.CFrame = originalCFrame * CFrame.new(0, 0.5, 0)
            end
        end
        
        Unfling()
    end)
end

FlingActionBtn.Activated:Connect(function()
    FlingTarget(FlingBox.Text)
end)
