-- 1. AIMBOT LOGIC
--------------------------------------------------------------------
local AimbotEnabled = false
local isLocked = false
local currentTarget = nil

local TOGGLE_KEY = Enum.KeyCode.E
local PREDICTION_FACTOR = 0.135
local CAMERA_SMOOTHNESS = 0.25 
local FOV_LIMIT = 250 

local function isKnife(tool)
    if not tool or not tool:IsA("Tool") then return false end
    local weaponType = tool:GetAttribute("WeaponType") or tool:GetAttribute("Type") or tool:GetAttribute("Class")
    if weaponType and string.find(tostring(weaponType):lower(), "knife") then return true end

    for _, child in ipairs(tool:GetDescendants()) do
        local name = child.Name:lower()
        if (child:IsA("Animation") and (name:find("slash") or name:find("stab") or name:find("knife"))) or
           ((child:IsA("BasePart") or child:IsA("SpecialMesh")) and (name:find("blade") or name:find("knife"))) then
            return true
        end
    end
    return false
end

local function hasKnife(player)
    local char = player.Character
    if char then
        for _, item in ipairs(char:GetChildren()) do
            if isKnife(item) then return true end
        end
    end
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if isKnife(item) then return true end
        end
    end
    return false
end

local function getClosestToCrosshair()
    local closestPlayer = nil
    local shortestDistance = FOV_LIMIT
    local viewportCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and hasKnife(player) then
            local char = player.Character
            if char then
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                local head = char:FindFirstChild("Head")

                if humanoid and head and humanoid.Health > 0 then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local mouseDist = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
                        if mouseDist < shortestDistance then
                            shortestDistance = mouseDist
                            closestPlayer = player
                        end
                    end
                end
            end
        end
    end
    return closestPlayer
end

local function isValidTarget(player)
    if not player or not player.Character then return false end
    local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
    local head = player.Character:FindFirstChild("Head")
    return humanoid and head and humanoid.Health > 0 and hasKnife(player)
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not AimbotEnabled then return end
    if input.KeyCode == TOGGLE_KEY then
        isLocked = not isLocked
        if isLocked then
            currentTarget = getClosestToCrosshair()
            if not currentTarget then
                isLocked = false
            end
        else
            currentTarget = nil
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if not AimbotEnabled or not isLocked then return end

    if not isValidTarget(currentTarget) then
        currentTarget = getClosestToCrosshair()
        if not currentTarget then
            isLocked = false
            return
        end
    end

    local char = currentTarget.Character
    local head = char:FindFirstChild("Head")
    local rootPart = char:FindFirstChild("HumanoidRootPart")

    if head and rootPart then
        local rawVelocity = rootPart.AssemblyLinearVelocity
        local adjustedVelocity = Vector3.new(rawVelocity.X, 0, rawVelocity.Z)
        local predictedPosition = head.Position + (adjustedVelocity * PREDICTION_FACTOR)

        local targetCFrame = CFrame.new(Camera.CFrame.Position, predictedPosition)
        Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, CAMERA_SMOOTHNESS)
    end
end)

AimbotBtn.Activated:Connect(function()
    AimbotEnabled = not AimbotEnabled
    UpdateSwitch(AimTrack, AimKnob, AimbotEnabled)
    if not AimbotEnabled then
        isLocked = false
    end
end)

