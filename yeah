local AutoFarmEnabled = false
local FARM_SPEED = 50

local NoclipConnection
local function ToggleNoclip(state)
    if state then
        if not NoclipConnection then
            NoclipConnection = RunService.Stepped:Connect(function()
                if LocalPlayer.Character then
                    for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                        if part:IsA("BasePart") and part.CanCollide then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if NoclipConnection then
            NoclipConnection:Disconnect()
            NoclipConnection = nil
        end
    end
end

local function isCoin(object)
    if not object:IsA("BasePart") and not object:IsA("Model") then return false end
    local name = object.Name:lower()
    return name:find("coin") or name:find("gold") or name:find("token") or name:find("credit")
end

local function getCoins()
    local coins = {}
    for _, object in ipairs(Workspace:GetDescendants()) do
        if isCoin(object) then
            local targetPart = object:IsA("Model") and (object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart")) or object
            if targetPart then
                table.insert(coins, targetPart)
            end
        end
    end
    return coins
end

task.spawn(function()
    while true do
        if AutoFarmEnabled then
            local Character = LocalPlayer.Character
            local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
            
            if RootPart then
                local coins = getCoins()
                for _, coin in ipairs(coins) do
                    if not AutoFarmEnabled then break end
                    
                    while coin and coin.Parent and LocalPlayer.Character and RootPart and AutoFarmEnabled do
                        local currentPos = RootPart.Position
                        local targetPos = coin.Position
                        local distance = (targetPos - currentPos).Magnitude

                        if distance < 3 then
                            RootPart.CFrame = CFrame.new(targetPos)
                            break
                        end

                        local direction = (targetPos - currentPos).Unit
                        RootPart.CFrame = CFrame.new(currentPos + direction * (FARM_SPEED * RunService.RenderStepped:Wait()))
                        RootPart.AssemblyLinearVelocity = Vector3.zero
                    end
                end
            end
        end
        task.wait(0.5)
    end
end)

AutoFarmBtn.Activated:Connect(function()
    AutoFarmEnabled = not AutoFarmEnabled
    UpdateSwitch(FarmTrack, FarmKnob, AutoFarmEnabled)
    ToggleNoclip(AutoFarmEnabled)
end)

