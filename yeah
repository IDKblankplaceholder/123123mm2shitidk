local ESPEnabled = false

local function checkItemType(tool, keywords)
    if not tool or not tool:IsA("Tool") then return false end

    local weaponType = tool:GetAttribute("WeaponType") or tool:GetAttribute("Type") or tool:GetAttribute("Class")
    if weaponType then
        local typeStr = tostring(weaponType):lower()
        for _, word in ipairs(keywords) do
            if typeStr:find(word) then return true end
        end
    end

    local toolName = tool.Name:lower()
    for _, word in ipairs(keywords) do
        if toolName:find(word) then return true end
    end

    for _, child in ipairs(tool:GetDescendants()) do
        local childName = child.Name:lower()
        for _, word in ipairs(keywords) do
            if childName:find(word) then return true end
        end
    end

    return false
end

local function hasGun(player)
    local keywords = {"gun", "revolver", "pistol", "sheriff", "shoot"}
    if player.Character then
        for _, item in ipairs(player.Character:GetChildren()) do
            if checkItemType(item, keywords) then return true end
        end
    end
    if player:FindFirstChild("Backpack") then
        for _, item in ipairs(player.Backpack:GetChildren()) do
            if checkItemType(item, keywords) then return true end
        end
    end
    return false
end

local function getRole(player)
    if hasKnife(player) then
        return "Murderer", Color3.fromRGB(255, 50, 50)
    elseif hasGun(player) then
        return "Sheriff", Color3.fromRGB(50, 150, 255)
    else
        return "Innocent", Color3.fromRGB(50, 255, 50)
    end
end

local function removeESP(player)
    if player.Character then
        if player.Character:FindFirstChild("RoleBox") then player.Character.RoleBox:Destroy() end
        local head = player.Character:FindFirstChild("Head")
        if head and head:FindFirstChild("RoleESP") then head.RoleESP:Destroy() end
    end
end

local function applyESP(player)
    if player == LocalPlayer or not ESPEnabled then return end
    local character = player.Character
    if not character then return end

    local head = character:FindFirstChild("Head")
    if not head then return end

    local billboard = head:FindFirstChild("RoleESP")
    if not billboard then
        billboard = Instance.new("BillboardGui")
        billboard.Name = "RoleESP"
        billboard.Adornee = head
        billboard.Size = UDim2.new(0, 150, 0, 30)
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.AlwaysOnTop = true

        local textLabel = Instance.new("TextLabel")
        textLabel.Name = "Label"
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.Font = Enum.Font.SourceSansBold
        textLabel.TextSize = 16
        textLabel.TextStrokeTransparency = 0.2
        textLabel.Parent = billboard
        billboard.Parent = head
    end

    local highlight = character:FindFirstChild("RoleBox")
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = "RoleBox"
        highlight.Adornee = character
        highlight.FillTransparency = 0.75
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = character
    end

    local role, color = getRole(player)
    billboard.Label.Text = player.Name .. "\n[" .. role .. "]"
    billboard.Label.TextColor3 = color
    highlight.FillColor = color
    highlight.OutlineColor = color
end

RunService.RenderStepped:Connect(function()
    if not ESPEnabled then return end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
